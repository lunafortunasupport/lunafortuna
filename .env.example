# ── دیتابیس ──
# توسعهٔ محلی (SQLite):
DATABASE_URL="file:./dev.db"
# پروداکشن (Vercel Postgres) — provider را در prisma/schema.prisma به postgresql تغییر دهید:
# DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# نرخ پیش‌فرض لیر (تومان) در نبود کانال تلگرام
DEFAULT_EXCHANGE_RATE="4800"

# ── تلگرام ──
BOT_TOKEN=""
ADMIN_CHAT_ID=""
RATE_TG_CHANNEL=""

# ── پنل ادمین (فاز ۱) ──
ADMIN_USERNAME="luna"
ADMIN_PASSWORD="strong-password-here"
ADMIN_SESSION_SECRET="random-long-secret"

# ── فاز ۲ (احراز هویت کامل) ──
# AUTH_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
