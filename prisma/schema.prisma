// LunaFortuna — Prisma schema
// توسعهٔ محلی: SQLite. برای پروداکشن Vercel، provider را به "postgresql" تغییر دهید
// (کوئری‌ها یکسان می‌مانند؛ فیلدهای JSON به‌صورت String ذخیره می‌شوند تا قابل‌حمل باشند).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── کتگوری بر اساس برند (بخش ۲) ──
model Brand {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  domain        String?
  siteUrl       String
  group         String   @default("clothing") // multi | clothing | sports | shoes | beauty | home | kids
  // لینک‌های عمیق تفکیک‌شده بر اساس جنسیت/زیردسته — JSON به‌صورت رشته
  categoryLinks String   @default("{}")
  tags          String   @default("[]") // JSON array of strings
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  // ── حراج (بخش ۲) ──
  saleUrl       String?  // صفحهٔ حراج/indirim برند
  saleActive    Boolean  @default(false) // آیا الان حراج فعال است؟ (دستی یا توسط ربات)
  saleLabel     String?  // متن بنر، مثل «حراج زمستانه»
  saleCheckedAt DateTime? // آخرین باری که ربات چک کرد
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── بنرهای صفحهٔ اصلی (قابل‌مدیریت توسط ادمین) ──
model Banner {
  id        String   @id @default(cuid())
  title     String   @default("")
  subtitle  String   @default("")
  imageUrl  String   @default("") // در نبود عکس، از گرادیان برند استفاده می‌شود
  link      String   @default("")
  ctaText   String   @default("")
  placement String   @default("promo") // hero | promo
  theme     String   @default("navy") // navy | gold | cream
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── کتگوری‌ها (موجودی و مرور برند) ──
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String
  scope     String    @default("warehouse") // warehouse | brand
  icon      String?
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([slug, scope])
}

// ── محصولات موجودی انبار تهران (بخش ۱) ──
model Product {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  brandName   String?
  images      String    @default("[]") // JSON array of image URLs
  sizes       String    @default("[]") // JSON array of size labels
  priceToman  Int
  stock       Int       @default(1)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── کاتالوگِ آینه‌ایِ ترندیول (پیش‌نمایش) — با سینکِ زمان‌بندی‌شده پر می‌شود، نه دستی ──
model MirrorProduct {
  id            String   @id @default(cuid())
  sourceSite    String // "trendyol" | "trendyol-milla"
  sourceId      Int
  sourceUrl     String
  brand         String
  category      String // کلیدِ خامِ ترکی (پایدار، برای فیلتر)
  categoryFa    String // برچسبِ فارسی برای نمایش
  nameTr        String
  nameFa        String?
  descriptionFa String?
  image         String?
  images        String   @default("[]") // JSON array
  attributes    String   @default("[]") // JSON: {labelFa, valueFa}[]
  searchText    String   @default("") // نام‌ها+برند به‌صورتِ lowercase (ترکیِ ایمن) برای contains
  minPriceTL    Float?
  ratingScore   Float?
  favoriteCount Int?
  // ── تخفیف (از فازِ لیستینگ) ──
  originalPriceTL Float?   // قیمتِ قبلی وقتی تخفیف هست (برای خط‌خورده)
  discountPct     Int?     // درصدِ تخفیف
  onSale          Boolean  @default(false)
  promoLabel      String?  // نامِ کمپین، مثل «۵۰٪ روی نفرِ سوم»
  // ── برندِ منتخب (ویترینِ جدا) ──
  featuredBrand   String?  // اسلاگ: trendyol-milla | happiness | trendyol-kids | trendyol-shoes | ambar (خالی = عمومی)
  // ── مخاطب (برای کالکشن‌های مردانه/بچگانه/خانه) ──
  // نوعِ لباس (category) بینِ زنانه/مردانه/بچگانه مشترک است («Gömlek» چه از کوئریِ «kadın gömlek»
  // پیدا شود چه «erkek gömlek»)، پس بدونِ این فیلد امکانِ فیلترکردنِ «فقط مردانه» نبود. مقدار از
  // همان کوئریِ سینک که محصول را پیدا کرده می‌آید (audience در CATEGORIES در sync-trendyol.mjs).
  audience        String?  // men | kids | home (خالی = زنانه/عمومی)
  isActive      Boolean  @default(true) // false = در آخرین سینک دیده نشد
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  variants      MirrorVariant[]

  @@unique([sourceSite, sourceId])
  @@index([category])
  @@index([brand])
  @@index([minPriceTL])
  @@index([isActive])
  @@index([onSale])
  @@index([featuredBrand])
  @@index([audience])
}

model MirrorVariant {
  id        String        @id @default(cuid())
  productId String
  product   MirrorProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  inStock   Boolean
  priceTL   Float?
  freeCargo Boolean       @default(false)

  @@unique([productId, size])
  @@index([productId])
  @@index([size])
}

// ── کاربران (فاز ۲) ──
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("customer") // customer | admin
  birthday      String? // "day/month" مثل 15/3
  referralCode  String    @unique
  referredBy    String? // کد معرفِ دعوت‌کننده
  referralUsed  Boolean   @default(false) // آیا تخفیف خرید اولِ خودش (به‌عنوان دعوت‌شده) مصرف شده؟
  referralRewardPending Boolean @default(false) // آیا پاداش معرف (برای خرید بعدی) در انتظار استفاده است؟
  // ── نوتیفیکیشنِ علاقه‌مندی (opt-in) ── خبردادن وقتی محصولِ لیستِ آرزو حراج/موجود شد.
  wishlistNotify      Boolean @default(false) // کاربر خواسته خبر بدهیم؟ (پیش‌فرض: نه — opt-in)
  wishlistNotifyAsked Boolean @default(false) // یک‌بار پرسیده‌ایم؟ (تا دوباره سراغش نرویم)
  createdAt     DateTime  @default(now())
  orders        Order[]
  favorites     Favorite[]
  cartItems     CartItem[]
}

// ── سبدِ خریدِ کاربرِ واردشده — تا بین دستگاه‌ها همگام بماند (مهمان‌ها در localStorage).
// اسنپ‌شاتِ نمایشی ذخیره می‌شود؛ قیمتِ نهایی موقعِ تسویه با نرخِ روز دوباره حساب/بازبینی می‌شود.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String // = MirrorProduct.id (بدون FK چون کاتالوگ با سینک بازساخته می‌شود)
  size      String
  name      String
  nameFa    String?
  brand     String
  image     String?
  sourceUrl String
  priceTL   Float
  freeCargo Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, productId, size])
  @@index([userId])
}

// ── علاقه‌مندی‌های کاربر (لیستِ آرزو) — به کاربر گره خورده تا در پروفایل و بین دستگاه‌ها بماند.
// مهمان‌ها (بدونِ ورود) در localStorage نگه می‌دارند؛ هنگام ورود ادغام می‌شود.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   // = MirrorProduct.id (بدون FK چون کاتالوگ با سینک بازساخته می‌شود)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// کد فعال‌سازی یک‌بارمصرف (ایمیل/موبایل)
model VerificationCode {
  id         String   @id @default(cuid())
  identifier String // ایمیل یا شماره موبایل
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier])
}

// ── سفارش‌ها ──
model Order {
  id           String   @id @default(cuid())
  shortId      String   @unique
  type         String   @default("link") // link | warehouse | find
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  // اطلاعات تماس مهمان (فاز ۱ بدون حساب)
  customerName String?
  contact      String?  // موبایل یا آیدی تلگرام
  // سفارش واسطه‌ای
  link         String?
  description  String?
  lirPrice     Float?
  feeType      String   @default("normal")
  referralKind String?  // new = خرید اولِ دعوت‌شده | reward = پاداشِ دعوت‌کننده
  referralRewarded Boolean @default(false) // آیا این سفارش، پاداش دعوت‌کننده را آزاد کرده؟
  // محصول انبار
  productId    String?
  priceToman   Int?
  status       String   @default("pending") // pending|paid|received|shipped|delivered|cancelled
  receiptUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── تنظیمات (تک‌ردیفه، id ثابت = "singleton") ──
model Settings {
  id             String   @id @default("singleton")
  exchangeRate   Int      @default(4800) // نرخ صرافی لیر (تومان)
  rateUpdatedAt  DateTime @default(now())
  rateSource     String   @default("manual") // manual | telegram
  feeNormal      Float    @default(0.15)
  feeSilver      Float    @default(0.12)
  feeGold        Float    @default(0.10)
  feeBirthday    Float    @default(0.12)
  feeReferral    Float    @default(0.12)
  cardNumber     String   @default("")
  cardOwner      String   @default("")
  cardBank       String   @default("")
  telegramBot    String   @default("LunaFortunaSupport_bot")
  telegramSupport String  @default("LunaFortunaSupport")
  instagram      String   @default("lunafortuna.shop")
  phone          String   @default("00905318662989")
  aboutContent   String   @default("{}") // JSON: متن و اعضای تیم
  cargoFeeEstimateTL Float @default(150) // برآوردِ هزینهٔ کارگوی داخلِ ترکیه وقتی freeCargo نیست
  updatedAt      DateTime @updatedAt
}
