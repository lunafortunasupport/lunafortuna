# ── دیتابیس ──
# توسعهٔ محلی (SQLite):
DATABASE_URL="file:./dev.db"
# پروداکشن (Vercel Postgres) — provider را در prisma/schema.prisma به postgresql تغییر دهید:
# DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# نرخ پیش‌فرض لیر (تومان) در نبود کانال تلگرام
DEFAULT_EXCHANGE_RATE="4800"

# ── تلگرام ──
BOT_TOKEN=""
ADMIN_CHAT_ID=""
RATE_TG_CHANNEL=""

# ── پنل ادمین (فاز ۱) ──
ADMIN_USERNAME="luna"
ADMIN_PASSWORD="strong-password-here"
ADMIN_SESSION_SECRET="random-long-secret"

# ── فاز ۲ (احراز هویت کامل) ──
AUTH_SECRET=""
# ورود با گوگل (اختیاری): از Google Cloud Console → OAuth 2.0 Client ID (نوع Web).
# Authorized redirect URIs باید شامل این‌ها باشد:
#   http://localhost:3000/api/auth/google/callback
#   https://www.lunafortuna.store/api/auth/google/callback
# اگر خالی بمانند، دکمهٔ «ورود با گوگل» پیام «فعال نشده» می‌دهد و ورود ایمیلی کار می‌کند.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# BLOB_READ_WRITE_TOKEN=""

# ── چت‌بات هوشمند (Claude از طریق Vercel AI Gateway) ──
# از https://vercel.com/[team]/~/ai-gateway/api-keys بگیرید (یا اگر روی خودِ Vercel دیپلوی شده، با OIDC خودکار کار می‌کند).
# اگر خالی بماند، ویجت چت روی سایت باز می‌شود ولی پیام خطا می‌دهد.
AI_GATEWAY_API_KEY=""
